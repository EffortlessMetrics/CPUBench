    "threshold": {
      "exclusiveMinimum": 0,
      "title": "Threshold",
      "type": "number"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "variant_set_id": {
      "title": "Variant Set Id",
      "type": "string"
    },
    "variant_set_version": {
      "title": "Variant Set Version",
      "type": "string"
    }
