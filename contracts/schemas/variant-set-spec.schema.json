        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "point_id": {
          "title": "Point Id",
          "type": "string"
        },
        "preserves": {
          "items": {
            "type": "string"
          },
          "title": "Preserves",
          "type": "array"
        },
        "role": {
          "enum": [
            "baseline",
            "challenge",
            "control"
          ],
          "title": "Role",
          "type": "string"
        },
        "transformation": {
          "title": "Transformation",
          "type": "string"
        }
