    "baseline_label": {
      "title": "Baseline Label",
      "type": "string"
    },
    "claim_boundary": {
      "items": {
        "type": "string"
      },
      "title": "Claim Boundary",
      "type": "array"
    },
    "comparison_metric": {
      "title": "Comparison Metric",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "members": {
      "items": {
        "$ref": "#/$defs/VariantMember"
      },
      "title": "Members",
      "type": "array"
    },
    "parent_ids": {
      "items": {
        "type": "string"
      },
