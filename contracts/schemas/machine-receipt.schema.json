{
  "$defs": {
    "CapabilityEvidence": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "title": "Authority",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "evidence": {
          "additionalProperties": true,
          "title": "Evidence",
          "type": "object"
        },
        "state": {
          "$ref": "#/$defs/CapabilityState"
        }
      },
      "required": [
        "state",
        "authority"
      ],
      "title": "CapabilityEvidence",
      "type": "object"
    },
    "CapabilityState": {
      "enum": [
        "qualified",
        "available_unqualified",
        "unsupported",
        "failed",
        "unknown"
      ],
      "title": "CapabilityState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_kind": {
      "const": "machine_receipt",
      "default": "machine_receipt",
      "title": "Artifact Kind",
      "type": "string"
    },
    "capabilities": {
      "additionalProperties": {
        "$ref": "#/$defs/CapabilityEvidence"
      },
      "title": "Capabilities",
      "type": "object"
    },
    "cpu": {
      "additionalProperties": true,
      "title": "Cpu",
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "known_unknowns": {
      "items": {
        "type": "string"
      },
      "title": "Known Unknowns",
      "type": "array"
    },
    "memory": {
      "additionalProperties": true,
      "title": "Memory",
      "type": "object"
    },
    "parent_ids": {
      "items": {
        "type": "string"
      },
      "title": "Parent Ids",
      "type": "array"
    },
    "runtime": {
      "additionalProperties": true,
      "title": "Runtime",
      "type": "object"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "semantic_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Semantic Id"
    },
    "system": {
      "additionalProperties": true,
      "title": "System",
      "type": "object"
    },
    "topology": {
      "additionalProperties": true,
      "title": "Topology",
      "type": "object"
    }
  },
  "required": [
    "system",
    "cpu",
    "topology",
    "memory",
    "runtime",
    "capabilities"
  ],
  "title": "MachineReceipt",
  "type": "object"
}
