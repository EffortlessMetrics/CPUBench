{
  "$defs": {
    "AttemptValidation": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "title": "Attempt Id",
          "type": "string"
        },
        "comparability": {
          "$ref": "#/$defs/ValidityOutcome"
        },
        "measurement_validity": {
          "$ref": "#/$defs/ValidityOutcome"
        },
        "obligations": {
          "items": {
            "$ref": "#/$defs/ObligationResult"
          },
          "title": "Obligations",
          "type": "array"
        },
        "work_validity": {
          "$ref": "#/$defs/ValidityOutcome"
        }
      },
      "required": [
        "attempt_id",
        "work_validity",
        "measurement_validity",
        "comparability",
        "obligations"
      ],
      "title": "AttemptValidation",
      "type": "object"
    },
    "CapabilityState": {
      "enum": [
        "qualified",
        "available_unqualified",
        "unsupported",
        "failed",
        "unknown"
      ],
      "title": "CapabilityState",
      "type": "string"
    },
    "ObligationResult": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "obligation_id": {
          "title": "Obligation Id",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/ValidityOutcome"
        },
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        }
      },
      "required": [
        "obligation_id",
        "outcome",
        "reason_code"
      ],
      "title": "ObligationResult",
      "type": "object"
    },
    "TimerQualification": {
      "additionalProperties": false,
      "properties": {
        "control_attempt_ids": {
          "items": {
            "type": "string"
          },
          "title": "Control Attempt Ids",
          "type": "array"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "effective_resolution_ns": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Resolution Ns"
        },
        "minimum_sample_duration_ns": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Sample Duration Ns"
        },
        "non_monotonic_observations": {
          "minimum": 0,
          "title": "Non Monotonic Observations",
          "type": "integer"
        },
        "observations": {
          "minimum": 0,
          "title": "Observations",
          "type": "integer"
        },
        "overhead_ratio": {
          "minimum": 10.0,
          "title": "Overhead Ratio",
          "type": "number"
        },
        "read_overhead_ns": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Read Overhead Ns"
        },
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/CapabilityState"
        },
        "timer": {
          "title": "Timer",
          "type": "string"
        },
        "zero_delta_observations": {
          "minimum": 0,
          "title": "Zero Delta Observations",
          "type": "integer"
        }
      },
      "required": [
        "timer",
        "state",
        "control_attempt_ids",
        "observations",
        "non_monotonic_observations",
        "zero_delta_observations",
        "overhead_ratio",
        "reason_code"
      ],
      "title": "TimerQualification",
      "type": "object"
    },
    "ValidityOutcome": {
      "enum": [
        "pass",
        "fail",
        "not_evaluated",
        "unsupported",
        "inconclusive"
      ],
      "title": "ValidityOutcome",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_kind": {
      "const": "validation_bundle",
      "default": "validation_bundle",
      "title": "Artifact Kind",
      "type": "string"
    },
    "attempts": {
      "items": {
        "$ref": "#/$defs/AttemptValidation"
      },
      "title": "Attempts",
      "type": "array"
    },
    "campaign_id": {
      "title": "Campaign Id",
      "type": "string"
    },
    "coverage": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Coverage",
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "parent_ids": {
      "items": {
        "type": "string"
      },
      "title": "Parent Ids",
      "type": "array"
    },
    "run_plan_id": {
      "title": "Run Plan Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "semantic_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Semantic Id"
    },
    "timer_qualifications": {
      "additionalProperties": {
        "$ref": "#/$defs/TimerQualification"
      },
      "title": "Timer Qualifications",
      "type": "object"
    },
    "validity_view": {
      "title": "Validity View",
      "type": "string"
    }
  },
  "required": [
    "campaign_id",
    "run_plan_id",
    "validity_view",
    "attempts",
    "coverage"
  ],
  "title": "ValidationBundle",
  "type": "object"
}
