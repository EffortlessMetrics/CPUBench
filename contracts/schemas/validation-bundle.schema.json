{
  "$defs": {
    "AttemptValidation": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "title": "Attempt Id",
          "type": "string"
        },
        "comparability": {
          "$ref": "#/$defs/ValidityOutcome"
        },
        "measurement_validity": {
          "$ref": "#/$defs/ValidityOutcome"
        },
        "obligations": {
          "items": {
            "$ref": "#/$defs/ObligationResult"
          },
          "title": "Obligations",
          "type": "array"
        },
        "work_validity": {
          "$ref": "#/$defs/ValidityOutcome"
        }
      },
      "required": [
        "attempt_id",
        "work_validity",
        "measurement_validity",
        "comparability",
        "obligations"
      ],
      "title": "AttemptValidation",
      "type": "object"
    },
    "ObligationResult": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "obligation_id": {
          "title": "Obligation Id",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/ValidityOutcome"
        },
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        }
      },
      "required": [
        "obligation_id",
        "outcome",
        "reason_code"
      ],
      "title": "ObligationResult",
      "type": "object"
    },
    "ValidityOutcome": {
      "enum": [
        "pass",
        "fail",
        "not_evaluated",
        "unsupported",
        "inconclusive"
      ],
      "title": "ValidityOutcome",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_kind": {
      "const": "validation_bundle",
      "default": "validation_bundle",
      "title": "Artifact Kind",
      "type": "string"
    },
    "attempts": {
      "items": {
        "$ref": "#/$defs/AttemptValidation"
      },
      "title": "Attempts",
      "type": "array"
    },
    "campaign_id": {
      "title": "Campaign Id",
      "type": "string"
    },
    "coverage": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Coverage",
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "parent_ids": {
      "items": {
        "type": "string"
      },
      "title": "Parent Ids",
      "type": "array"
    },
    "run_plan_id": {
      "title": "Run Plan Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "semantic_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Semantic Id"
    },
    "validity_view": {
      "title": "Validity View",
      "type": "string"
    }
  },
  "required": [
    "campaign_id",
    "run_plan_id",
    "validity_view",
    "attempts",
    "coverage"
  ],
  "title": "ValidationBundle",
  "type": "object"
}
