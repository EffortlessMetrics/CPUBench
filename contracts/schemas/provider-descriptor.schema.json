      "title": "Protocol Version",
      "type": "integer"
    },
    "provider_id": {
      "title": "Provider Id",
      "type": "string"
    },
    "provider_version": {
      "title": "Provider Version",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "semantic_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
