          "type": "array"
        },
        "family_id": {
          "title": "Family Id",
          "type": "string"
        },
        "implementation_id": {
          "title": "Implementation Id",
          "type": "string"
        },
        "supported_arch": {
          "items": {
            "type": "string"
          },
          "title": "Supported Arch",
          "type": "array"
        },
        "supported_os": {
          "items": {
            "type": "string"
          },
          "title": "Supported Os",
          "type": "array"
        },
        "timing_authority": {
          "title": "Timing Authority",
          "type": "string"
        }
      },
      "required": [
        "family_id",
        "implementation_id",
        "supported_os",
        "supported_arch",
        "timing_authority"
